NODE_ENV=development
PORT=5000

DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Must be the exact frontend origin for credentialed CORS + refresh cookies.
CORS_ORIGIN=http://localhost:3000

# ---- Google Sign-In (Google Identity Services) ----
# OAuth 2.0 Client ID from Google Cloud Console; used to validate the audience
# of ID tokens posted to POST /api/auth/google.
GOOGLE_CLIENT_ID=

# ---- Outbound message delivery (OTP + password reset emails) ----
# console : development/test only. Prints messages (including OTP codes) to the
#           server log. Refuses to run when NODE_ENV=production.
# webhook : production capable. POSTs {to, subject, text} as JSON to
#           EMAIL_WEBHOOK_URL, optionally with an Authorization Bearer header
#           (EMAIL_WEBHOOK_TOKEN), where your email/SMS provider integration
#           picks it up.
# none    : delivery disabled; verification/reset endpoints fail with 503.
EMAIL_DELIVERY_PROVIDER=console
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# ---- OTP verification policy (4-digit code is fixed by the product design) ----
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS_PER_HOUR=5

# ---- Password reset policy ----
RESET_TOKEN_EXPIRY_MINUTES=30
RESET_TOKEN_MAX_ATTEMPTS=5
