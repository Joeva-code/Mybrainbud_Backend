{
  "info": {
    "name": "MyBrainBud Onboarding API",
    "description": "3-step student onboarding wizard for the MyBrainBud backend (v1.1.0).\n\nCovers the exam -> year -> subjects journey plus the completion screen, backed by GET /api/onboarding/options (wizard choices) and GET /api/onboarding (resume state).\n\nSETUP:\n1. Set `baseUrl` (defaults to http://localhost:5000).\n2. Sign in as a STUDENT (register -> verify-otp -> login from the Auth collection) and paste the access token into `accessToken`. All onboarding endpoints require a STUDENT Bearer token.\n3. Run the requests in order inside the 'Onboarding' folder:\n   options -> state -> exam -> year -> subjects -> complete.\n   The first two subject ids from 'options' are captured automatically    into `subjectId1` / `subjectId2` so 'subjects' works without manual    copy/paste.\n\nNOTES:\n- Exams: WAEC, JAMB, NECO, GCE. Years: YEAR_1 .. YEAR_6.\n- Subjects: pick 1-10 active subject ids from the options response.\n- `complete` returns 400 until exam, year, AND subjects are all set.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "subjectId1",
      "value": ""
    },
    {
      "key": "subjectId2",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Onboarding",
      "item": [
        {
          "name": "GET /api/onboarding/options",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/options",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "options"
              ]
            },
            "description": "Step choices for the wizard: exams, years, and active subjects.\n\n- `exams` is a static list of the 4 supported options (WAEC/JAMB/NECO/GCE).\n- `years` is YEAR_1 .. YEAR_6.\n- `subjects` are the active Subject rows (id, name, code), ordered by name.\n  Use these ids in PUT /api/onboarding/subjects.\n\nRequires a STUDENT Bearer token.\n\nResponses: 200 | 401 (missing/invalid token) | 403 (non-student role)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns 4 exam options', () => pm.expect(pm.response.json().data.exams).to.have.lengthOf(4));",
                  "pm.test('returns 6 year options', () => pm.expect(pm.response.json().data.years).to.have.lengthOf(6));",
                  "// Capture the first two subject ids so the subjects request works immediately.",
                  "if (pm.response.code === 200) {",
                  "  const subjects = pm.response.json().data.subjects || [];",
                  "  if (subjects[0]) pm.collectionVariables.set('subjectId1', subjects[0].id);",
                  "  if (subjects[1]) pm.collectionVariables.set('subjectId2', subjects[1].id);",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Options - 200",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/onboarding/options",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "onboarding",
                    "options"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Onboarding options retrieved\",\n  \"data\": {\n    \"exams\": [\n      {\n        \"type\": \"WAEC\",\n        \"name\": \"West African Examinations Council (WAEC)\"\n      },\n      {\n        \"type\": \"JAMB\",\n        \"name\": \"Joint Admissions and Matriculation Board (JAMB)\"\n      },\n      {\n        \"type\": \"NECO\",\n        \"name\": \"National Examinations Council (NECO)\"\n      },\n      {\n        \"type\": \"GCE\",\n        \"name\": \"General Certificate of Education (GCE)\"\n      }\n    ],\n    \"years\": [\n      {\n        \"value\": \"YEAR_1\",\n        \"label\": \"Year 1\"\n      },\n      {\n        \"value\": \"YEAR_2\",\n        \"label\": \"Year 2\"\n      },\n      {\n        \"value\": \"YEAR_3\",\n        \"label\": \"Year 3\"\n      },\n      {\n        \"value\": \"YEAR_4\",\n        \"label\": \"Year 4\"\n      },\n      {\n        \"value\": \"YEAR_5\",\n        \"label\": \"Year 5\"\n      },\n      {\n        \"value\": \"YEAR_6\",\n        \"label\": \"Year 6\"\n      }\n    ],\n    \"subjects\": [\n      {\n        \"id\": \"sub_biology\",\n        \"name\": \"Biology\",\n        \"code\": \"BIO\"\n      },\n      {\n        \"id\": \"sub_chemistry\",\n        \"name\": \"Chemistry\",\n        \"code\": \"CHEM\"\n      },\n      {\n        \"id\": \"sub_english\",\n        \"name\": \"English Language\",\n        \"code\": \"ENG\"\n      },\n      {\n        \"id\": \"sub_maths\",\n        \"name\": \"Mathematics\",\n        \"code\": \"MATH\"\n      },\n      {\n        \"id\": \"sub_physics\",\n        \"name\": \"Physics\",\n        \"code\": \"PHY\"\n      }\n    ]\n  }\n}"
            }
          ]
        },
        {
          "name": "GET /api/onboarding (state)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding"
              ]
            },
            "description": "Full onboarding state so the client can resume at the right step.\n\n- `currentStep` is one of EXAM, YEAR, SUBJECTS, COMPLETE.\n- `exam` / `studyYear` are null until set; `subjects` starts empty.\n\nRequires a STUDENT Bearer token.\n\nResponses: 200 | 401 | 403 | 404 (no student profile)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns a currentStep', () => pm.expect(pm.response.json().data.currentStep).to.be.a('string'));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "State (fresh) - 200",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/onboarding",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "onboarding"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Onboarding state retrieved\",\n  \"data\": {\n    \"currentStep\": \"EXAM\",\n    \"exam\": null,\n    \"studyYear\": null,\n    \"subjects\": [],\n    \"onboardingComplete\": false\n  }\n}"
            }
          ]
        },
        {
          "name": "PUT /api/onboarding/exam",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/exam",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "exam"
              ]
            },
            "description": "Step 1 - save the examination the student is writing.\n\n- `examType` must be one of: WAEC, JAMB, NECO, GCE.\n- Links the matching Exam row to the student profile (created if missing).\n- Response includes the new `currentStep` (YEAR after step 1).\n\nRequires a STUDENT Bearer token.\n\nResponses: 200 | 400 (validation / save failed) | 401 | 403 | 404.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"examType\": \"WAEC\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('exam type is WAEC', () => pm.expect(pm.response.json().data.exam.type).to.eql('WAEC'));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Set exam - 200",
              "originalRequest": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/onboarding/exam",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "onboarding",
                    "exam"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Exam selection saved\",\n  \"data\": {\n    \"exam\": {\n      \"type\": \"WAEC\",\n      \"name\": \"West African Examinations Council (WAEC)\"\n    },\n    \"currentStep\": \"YEAR\"\n  }\n}"
            }
          ]
        },
        {
          "name": "PUT /api/onboarding/year",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/year",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "year"
              ]
            },
            "description": "Step 2 - save the student's year of study.\n\n- `studyYear` must be one of: YEAR_1, YEAR_2, YEAR_3, YEAR_4, YEAR_5, YEAR_6.\n- Response includes the new `currentStep` (SUBJECTS after step 2).\n\nRequires a STUDENT Bearer token.\n\nResponses: 200 | 400 (validation) | 401 | 403 | 404.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studyYear\": \"YEAR_3\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('study year is YEAR_3', () => pm.expect(pm.response.json().data.studyYear).to.eql('YEAR_3'));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Set year - 200",
              "originalRequest": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/onboarding/year",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "onboarding",
                    "year"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Study year saved\",\n  \"data\": {\n    \"studyYear\": \"YEAR_3\",\n    \"currentStep\": \"SUBJECTS\"\n  }\n}"
            }
          ]
        },
        {
          "name": "PUT /api/onboarding/subjects",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/subjects",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "subjects"
              ]
            },
            "description": "Step 3 - save the subjects the student is most confident in.\n\n- `subjectIds`: 1-10 active subject ids (from GET /options).\n- Replaces the student's previous selection.\n- Unknown or inactive ids return 400; nothing is saved.\n- Response includes the new `currentStep` (COMPLETE once all steps are set).\n\nRequires a STUDENT Bearer token.\n\nResponses: 200 | 400 (validation / invalid ids) | 401 | 403 | 404.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subjectIds\": [\n    \"{{subjectId1}}\",\n    \"{{subjectId2}}\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns selected subjects', () => pm.expect(pm.response.json().data.subjects.length).to.be.above(0));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Set subjects - 200",
              "originalRequest": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/onboarding/subjects",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "onboarding",
                    "subjects"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Subject selection saved\",\n  \"data\": {\n    \"subjects\": [\n      {\n        \"id\": \"sub_biology\",\n        \"name\": \"Biology\",\n        \"code\": \"BIO\"\n      },\n      {\n        \"id\": \"sub_chemistry\",\n        \"name\": \"Chemistry\",\n        \"code\": \"CHEM\"\n      }\n    ],\n    \"currentStep\": \"COMPLETE\"\n  }\n}"
            }
          ]
        },
        {
          "name": "POST /api/onboarding/complete",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/onboarding/complete",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "onboarding",
                "complete"
              ]
            },
            "description": "Finish screen - marks onboarding complete.\n\n- Requires exam, year, AND subjects to all be set first; otherwise 400\n  listing what is missing, e.g. 'missing exam, studyYear, subjects'.\n- `onboardingComplete` = the wizard is done; `profileComplete` reflects the\n  fuller profile requirements (class level, gender, DOB, ...) and may still\n  be false.\n\nRequires a STUDENT Bearer token.\n\nResponses: 200 | 400 (steps missing) | 401 | 403 | 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('onboarding is complete', () => pm.expect(pm.response.json().data.onboardingComplete).to.eql(true));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Complete - 200",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/onboarding/complete",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "onboarding",
                    "complete"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": true,\n  \"message\": \"Onboarding completed\",\n  \"data\": {\n    \"onboardingComplete\": true,\n    \"profileComplete\": false\n  }\n}"
            },
            {
              "name": "Complete too early - 400",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/onboarding/complete",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "onboarding",
                    "complete"
                  ]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"success\": false,\n  \"message\": \"Onboarding cannot be completed yet: missing exam, studyYear, subjects\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
